APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CAD_DOCUMENT_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@uclm-scms.edu.ph"
MAIL_FROM_NAME="UCLM Student Concern Management System"

# Production / Live SMTP Examples (Laravel 12 uses MAIL_SCHEME: "smtp" for STARTTLS on 587, "smtps" for SSL/TLS on 465):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp                   # use "smtp" on port 587 (STARTTLS) or "smtps" on port 465 (SSL/TLS)
# MAIL_HOST=smtp.gmail.com           # or smtp-relay.brevo.com
# MAIL_PORT=587                      # or 465 when MAIL_SCHEME=smtps
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM_ADDRESS="no-reply@uclm-scms.edu.ph"
# MAIL_FROM_NAME="UCLM SCMS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
